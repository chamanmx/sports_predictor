# Global application settings
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
APP_NAME=sports_predictor

# Database - defaults to SQLite for development
DATABASE_URL=sqlite:///./sports_predictor.db
POSTGRES_DB=sports_predictor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis
REDIS_URL=redis://localhost:6379/0

# Sports APIs
SPORTS_API_BASE_URL=https://api.example.com
SPORTS_API_KEY=your_api_key_here

# Model config
MODEL_SAVE_DIR=./backend/models
DEFAULT_CACHE_TTL=300
MAX_REQUESTS_PER_SECOND=10

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=sports_predictor
